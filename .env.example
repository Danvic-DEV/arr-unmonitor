# Copy this file to .env and fill in your values.
# .env is gitignored and will NOT be committed.

RADARR_URL=http://localhost:7878
RADARR_API_KEY=your-radarr-api-key-here
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your-sonarr-api-key-here

# Optional overrides
# SETTINGS_PATH=./config/settings.json
# CHANGE_LOG_PATH=./config/change-log.jsonl
# LOG_PATH=./config/app-log.jsonl
# PORT=5200

# Log rotation size caps in bytes (defaults shown: 32 MB each)
# LOG_MAX_BYTES=33554432
# CHANGE_LOG_MAX_BYTES=33554432
